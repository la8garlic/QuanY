{
  "productName": "泉涌",
  "version": "1.6.1",
  "identifier": "cn.jianji.writer",
  "build": { "frontendDist": "dist", "beforeBuildCommand": "npm run build" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "title": "泉涌",
      "visible": false,
      "decorations": false,
      "width": 1040,
      "height": 740,
      "minWidth": 540,
      "minHeight": 420,
      "center": true,
      "dragDropEnabled": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'",
      "capabilities": [{
        "identifier": "editor",
        "windows": ["main","memo-*"],
        "permissions": ["core:event:allow-listen", "core:event:allow-unlisten", "core:window:allow-destroy","core:window:allow-hide",
          "core:window:allow-close", "core:window:allow-minimize", "core:window:allow-is-maximized",
          "core:window:allow-toggle-maximize", "core:window:allow-start-dragging", "core:window:allow-internal-toggle-maximize"]
      }]
    }
  },
  "bundle": { "active": false, "icon": ["assets/icon.ico"] }
}
